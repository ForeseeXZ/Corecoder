# Copy this file to .env and fill the real values on each machine.
# Never commit .env; it is ignored by git.

# MiMo OpenAI-compatible API endpoint and key.
# Keep the /v1 suffix if your provider documents it that way.
OPENAI_BASE_URL=https://your-mimo-compatible-endpoint/v1
OPENAI_API_KEY=replace-with-your-mimo-api-key

# Executor: fast/default coding model.
CORECODER_MODEL=mimo-v2.5

# Planner: stronger planning model used only when --planner is enabled.
CORECODER_PLANNER_MODEL=mimo-v2.5-pro

# New eval outputs go here by default in the code too.
CORECODER_RUNS_DIR=eval/runs_mimo

# Optional: fill this only if you know MiMo's RMB price per 1M input/output tokens.
# Example shape:
# CORECODER_PRICING_CNY_PER_M={"mimo-v2.5":[1,2],"mimo-v2.5-pro":[3,6]}
